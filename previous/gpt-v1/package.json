{
  "name": "altitude",
  "version": "0.0.0",
  "private": true,
  "description": "An intent control plane for delegated agentic development",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "bin": {
    "altitude": "./dist/altitude"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/altitude",
    "check": "bun run typecheck",
    "dev": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@linear/sdk": "92.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@number0/iroh": "1.1.0",
    "ink": "7.1.1",
    "microsandbox": "0.6.16",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "zod": "4"
  }
}
