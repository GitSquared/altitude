{
	"name": "altitude",
	"version": "0.0.1",
	"module": "src/index.tsx",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "NODE_ENV=development bun --watch --watch-kill-signal SIGKILL src/index.tsx",
		"debug": "DEV=true bun run dev",
		"devtools": "bun node_modules/electron/install.js && bunx react-devtools",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write .",
		"lint": "biome lint .",
		"fmt": "biome format .",
		"build": "bun build src/index.tsx --compile --external react-devtools-core --production --format=esm --splitting --minify --bytecode --outfile dist/altitude"
	},
	"dependencies": {
		"@inkjs/ui": "2.0.0",
		"env-paths": "4.0.0",
		"ink": "7.1.1",
		"microsandbox": "0.6.16",
		"react": "19.2.8"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "latest",
		"@types/react": "19.2.18",
		"lefthook": "2.1.12",
		"react-devtools": "7.0.1"
	}
}
